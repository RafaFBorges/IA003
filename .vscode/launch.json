{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: rodar app",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app/app.py", "--server.headless", "true", "--browser.gatherUsageStats", "false"],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "console": "integratedTerminal"
    }
  ]
}
